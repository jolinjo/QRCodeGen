{
  "manifest_version": 3,
  "name": "QR Code Generator (Local Python)",
  "version": "0.1.0",
  "description": "呼叫本地 Python 服務產生 QR 碼 (離線)",
  "permissions": ["tabs"],
  "action": {
    "default_title": "QR Code Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["logos/*.svg"],
    "matches": ["<all_urls>"]
  }]
}
